# ===========================================================================
# Mẫu biến môi trường. Sao chép file này thành ".env" và điền giá trị thật.
# KHÔNG commit file .env chứa giá trị thật lên git.
# ===========================================================================

# ---- Server ----
# Cổng chạy backend Express
PORT=4000
# Môi trường: development | production | test
NODE_ENV=development
# URL của frontend (dùng cho cấu hình CORS)
CLIENT_ORIGIN=http://localhost:5173
# URL public của API khi tách frontend/backend. Deploy chung domain có thể bỏ trống.
PUBLIC_API_URL=

# ---- Database (PostgreSQL) ----
# Định dạng: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learn_programming?schema=public
# Chỉ bật khi chủ động muốn nạp lại toàn bộ dữ liệu hoặc đồng bộ tài khoản demo.
SEED_FORCE=false
SEED_SYNC_DEMOS=false
SEED_SYNC_CONTESTS=false

# ---- Xác thực (JWT) ----
# Chuỗi bí mật để ký JWT. Đặt một chuỗi ngẫu nhiên dài, khó đoán.
JWT_SECRET=thay-bang-mot-chuoi-bi-mat-ngau-nhien-that-dai
# Thời gian sống của access token
JWT_EXPIRES_IN=7d

# ---- Email xác thực đăng ký (Gmail SMTP) ----
# Với Gmail, bật 2-Step Verification rồi tạo App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="CodeLearn <your-gmail@gmail.com>"

# ---- EmailJS gửi email qua HTTPS API (hợp với Render Free) ----
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_VERIFY_ID=
EMAILJS_TEMPLATE_RESET_ID=
EMAILJS_TEMPLATE_NOTIFICATION_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- VietQR thanh toán khoá học ----
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact2
# API key tự đặt trong SePay Webhook, dùng để SePay gọi xác nhận chuyển khoản.
SEPAY_WEBHOOK_API_KEY=thay-bang-mot-api-key-random
# SePay Payment Gateway/IPN. Secret key lấy trong màn hình tích hợp SePay, không commit giá trị thật.
SEPAY_PG_MERCHANT_ID=
SEPAY_PG_SECRET_KEY=
SEPAY_PG_ENV=sandbox
# Chỉ dùng khi demo local. Luôn bị vô hiệu trong NODE_ENV=production.
PAYMENT_DEMO_ENABLED=false

# ---- Trợ lý AI local (Llama / OpenAI-compatible server) ----
# Ví dụ chạy llama.cpp server hoặc llama-cpp-python server local và trỏ về /v1.
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
# Để trống nếu server local không yêu cầu token.
LOCAL_LLM_API_KEY=
# Tên model do server local công bố; một số server bỏ qua giá trị này.
LOCAL_LLM_MODEL=local-llama
# Bật semantic RAG bằng Transformers.js. Render Free nên để false để tránh crash/native memory.
ENABLE_SEMANTIC_RAG=false

# ---- Trình chạy code C/C++/Python khi nộp bài (Judge0 CE local) ----
# Chạy Judge0 CE bằng Docker ở máy local, mặc định API mở tại http://localhost:2358.
JUDGE0_URL=http://localhost:2358
# Có thể ánh xạ runtime riêng, ví dụ {"JAVA":62,"PYTHON":71}.
JUDGE0_LANGUAGE_MAP=
# Giới hạn bảo vệ Judge0 trên mỗi backend instance.
JUDGE0_MAX_CONCURRENT=32
JUDGE0_MAX_QUEUE=200
JUDGE0_QUEUE_TIMEOUT_MS=15000
JUDGE0_RESULT_TIMEOUT_MS=30000
