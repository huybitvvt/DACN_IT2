# ===========================================================================
# Mẫu biến môi trường. Sao chép file này thành ".env" và điền giá trị thật.
# KHÔNG commit file .env chứa giá trị thật lên git.
# ===========================================================================

# ---- Server ----
# Cổng chạy backend Express
PORT=4000
# Môi trường: development | production | test
NODE_ENV=development
# URL của frontend (dùng cho cấu hình CORS)
CLIENT_ORIGIN=http://localhost:5173
# URL public của API khi tách frontend/backend. Deploy chung domain có thể bỏ trống.
PUBLIC_API_URL=

# ---- Database (PostgreSQL) ----
# Định dạng: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learn_programming?schema=public

# ---- Xác thực (JWT) ----
# Chuỗi bí mật để ký JWT. Đặt một chuỗi ngẫu nhiên dài, khó đoán.
JWT_SECRET=thay-bang-mot-chuoi-bi-mat-ngau-nhien-that-dai
# Thời gian sống của access token
JWT_EXPIRES_IN=7d

# ---- Email xác thực đăng ký (Gmail SMTP) ----
# Với Gmail, bật 2-Step Verification rồi tạo App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="CodeLearn <your-gmail@gmail.com>"

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- VietQR thanh toán khoá học ----
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact2
# API key tự đặt trong SePay Webhook, dùng để SePay gọi xác nhận chuyển khoản.
SEPAY_WEBHOOK_API_KEY=thay-bang-mot-api-key-random

# ---- Groq API (Trợ lý AI) ----
# Lấy khoá tại https://console.groq.com
GROQ_API_KEY=
# Model sử dụng (ví dụ: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
# Bật semantic RAG bằng Transformers.js. Render Free nên để false để tránh crash/native memory.
ENABLE_SEMANTIC_RAG=false

# ---- Trình chạy code C/C++ (Wandbox) ----
# Wandbox là dịch vụ biên dịch online miễn phí, KHÔNG cần API key.
WANDBOX_URL=https://wandbox.org
