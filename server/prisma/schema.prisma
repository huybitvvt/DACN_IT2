// Prisma schema cho Website hỗ trợ học lập trình.
// Tham chiếu ERD trong .kiro/specs/learn-programming-platform/design.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  LEARNER
  ADMIN
}

enum SubmissionStatus {
  PASSED
  FAILED
  ERROR
}

enum QuestionType {
  SINGLE
  MULTI
}

enum ProgressItemType {
  LESSON
  EXERCISE
  QUIZ
}

enum PurchaseStatus {
  PENDING
  PAID
}

enum ContestStatus {
  UPCOMING
  ACTIVE
  FINISHED
}

enum ContestRewardType {
  TUITION_REFUND
  VOUCHER
  BADGE
  UNLOCK
}

enum RewardClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContestProblemType {
  EXERCISE
  QUIZ
}

enum ContestAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum NotificationType {
  SYSTEM
  PAYMENT
  REWARD
  CONTEST
  RETENTION
  BADGE
}

enum InterventionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum InterventionSource {
  SYSTEM
  ADMIN
}

// ---------------------------------------------------------------------------
// Người dùng & gamification
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  googleId       String?   @unique
  displayName    String
  passwordHash   String
  role           Role      @default(LEARNER)
  streakCount    Int       @default(0)
  lastActiveDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  submissions            Submission[]
  quizAttempts           QuizAttempt[]
  progress               Progress[]
  badges                 UserBadge[]
  notes                  LessonNote[]
  comments               Comment[]
  passwordReset          PasswordResetToken?
  purchases              CoursePurchase[]
  rewardClaims           RewardClaim[]
  contestAttempts        ContestAttempt[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  interventions          LearningIntervention[]  @relation("InterventionRecipient")
  createdInterventions   LearningIntervention[]  @relation("InterventionCreator")

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RegistrationVerification {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique
  title       String
  description String
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Nội dung học liệu
// ---------------------------------------------------------------------------

model Course {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  language    String              @db.VarChar(80)
  description String
  priceVnd    Int                 @default(2000)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  lessons   Lesson[]
  progress  Progress[]
  purchases CoursePurchase[]
}

model CoursePurchase {
  id          String         @id @default(cuid())
  userId      String
  courseId    String
  status      PurchaseStatus @default(PENDING)
  amountVnd   Int
  paymentCode String         @unique
  paidAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([status, userId])
}

model SepayWebhookEvent {
  id          String   @id @default(cuid())
  sepayId     Int      @unique
  paymentCode String?
  payload     Json
  createdAt   DateTime @default(now())

  @@index([paymentCode])
}

model SepayPaymentGatewayIpnEvent {
  id            String   @id @default(cuid())
  transactionId String   @unique
  invoiceNumber String?
  payload       Json
  createdAt     DateTime @default(now())

  @@index([invoiceNumber])
}

// ---------------------------------------------------------------------------
// Thi đua, xếp hạng theo mùa & phần thưởng
// ---------------------------------------------------------------------------

model Contest {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String
  status          ContestStatus @default(ACTIVE)
  courseSlug      String?
  startsAt        DateTime
  endsAt          DateTime
  scoringNote     String
  durationMinutes Int           @default(60)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rewards      ContestReward[]
  rewardClaims RewardClaim[]
  problems     ContestProblem[]
  attempts     ContestAttempt[]

  @@index([status, startsAt, endsAt])
  @@index([courseSlug])
}

model ContestProblem {
  id          String             @id @default(cuid())
  contestId   String
  problemType ContestProblemType
  exerciseId  String?
  quizId      String?
  title       String
  points      Int                @default(100)
  order       Int                @default(0)

  contest  Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  quiz     Quiz?     @relation(fields: [quizId], references: [id], onDelete: SetNull)

  @@index([contestId, order])
  @@index([exerciseId])
  @@index([quizId])
}

model ContestAttempt {
  id          String               @id @default(cuid())
  contestId   String
  userId      String
  status      ContestAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime             @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  score       Int                  @default(0)
  maxScore    Int                  @default(0)

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contestId, userId, status])
  @@index([contestId, status, userId])
  @@index([userId, startedAt])
}

model ContestReward {
  id          String            @id @default(cuid())
  contestId   String
  rankFrom    Int
  rankTo      Int
  title       String
  description String
  rewardType  ContestRewardType
  valueVnd    Int?
  percentOff  Int?

  contest Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  claims  RewardClaim[]

  @@index([contestId])
}

model RewardClaim {
  id         String            @id @default(cuid())
  userId     String
  contestId  String
  rewardId   String
  rank       Int
  score      Int
  status     RewardClaimStatus @default(PENDING)
  note       String            @default("")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  reviewedAt DateTime?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  reward  ContestReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId, rewardId])
  @@index([contestId, status])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Thông báo & can thiệp giữ nhịp
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  href      String?
  metadata  Json?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  userId         String   @id
  emailPayments  Boolean  @default(true)
  emailRewards   Boolean  @default(true)
  emailContests  Boolean  @default(false)
  emailRetention Boolean  @default(true)
  emailBadges    Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningIntervention {
  id                  String             @id @default(cuid())
  userId              String
  createdById         String?
  source              InterventionSource @default(SYSTEM)
  status              InterventionStatus @default(ACTIVE)
  reason              String
  reasonFactors       Json
  baselineHealthScore Int
  targetMissions      Int
  completedMissions   Int                @default(0)
  startsAt            DateTime           @default(now())
  dueAt               DateTime
  completedAt         DateTime?
  outcome             Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user      User                  @relation("InterventionRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?                 @relation("InterventionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  missions  InterventionMission[]

  @@index([userId, status, createdAt])
  @@index([createdById])
}

model InterventionMission {
  id               String    @id @default(cuid())
  interventionId   String
  missionKey       String
  type             String
  itemId           String?
  title            String
  description      String
  ctaHref          String
  estimatedMinutes Int
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  intervention LearningIntervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@unique([interventionId, missionKey])
  @@index([interventionId, completedAt])
  @@index([itemId])
}

model Lesson {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  contentMarkdown String
  order           Int      @default(0)
  isPublic        Boolean  @default(true)
  embedding       Json? // vector embedding (mảng số) cho RAG ngữ nghĩa
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  examples  Example[]
  exercises Exercise[]
  quiz      Quiz?
  notes     LessonNote[]
  comments  Comment[]

  @@index([courseId, order])
}

model Example {
  id       String              @id @default(cuid())
  lessonId String
  language String @db.VarChar(80)
  code     String
  order    Int                 @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// ---------------------------------------------------------------------------
// Bài tập & chấm điểm
// ---------------------------------------------------------------------------

model Exercise {
  id             String              @id @default(cuid())
  lessonId       String
  title          String
  promptMarkdown String
  language       String              @db.VarChar(80)
  starterCode    String              @default("")
  order          Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  lesson          Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  testCases       TestCase[]
  submissions     Submission[]
  contestProblems ContestProblem[]

  @@index([lessonId])
}

model TestCase {
  id             String  @id @default(cuid())
  exerciseId     String
  input          String  @default("")
  expectedOutput String
  isHidden       Boolean @default(false)
  order          Int     @default(0)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}

model Submission {
  id               String           @id @default(cuid())
  userId           String
  exerciseId       String
  sourceCode       String
  passedCount      Int              @default(0)
  totalCount       Int              @default(0)
  status           SubmissionStatus @default(FAILED)
  errorCategory    String?
  errorFingerprint String?
  errorSummary     String?
  createdAt        DateTime         @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId])
  @@index([userId, status, createdAt])
}

// ---------------------------------------------------------------------------
// Quiz
// ---------------------------------------------------------------------------

model Quiz {
  id        String   @id @default(cuid())
  lessonId  String   @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson          Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions       Question[]
  attempts        QuizAttempt[]
  contestProblems ContestProblem[]
}

model Question {
  id     String       @id @default(cuid())
  quizId String
  text   String
  type   QuestionType @default(SINGLE)
  order  Int          @default(0)

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices Choice[]

  @@index([quizId])
}

model Choice {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  total     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Tiến độ học tập
// ---------------------------------------------------------------------------

model Progress {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  itemType    ProgressItemType
  itemId      String
  completed   Boolean          @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId, courseId])
  @@index([userId, completed, completedAt])
}

// Ghi chú & đánh dấu bài học của người dùng (#8).
model LessonNote {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String
  content    String   @default("")
  bookmarked Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

// Bình luận/hỏi đáp dưới bài học (#9).
model Comment {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, createdAt])
}
